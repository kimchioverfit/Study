<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Quantization on Study Notes</title><link>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/</link><description>Recent content in Quantization on Study Notes</description><generator>Hugo</generator><language>ko-kr</language><atom:link href="https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/index.xml" rel="self" type="application/rss+xml"/><item><title/><link>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/0.overview/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/0.overview/</guid><description>&lt;h1 id="overview"&gt;Overview&lt;/h1&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;구분&lt;/th&gt;
					&lt;th&gt;정밀도&lt;/th&gt;
					&lt;th&gt;속도 향상&lt;/th&gt;
					&lt;th&gt;정확도 손실&lt;/th&gt;
					&lt;th&gt;학습 필요&lt;/th&gt;
					&lt;th&gt;활용 예시&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;PTQ-Dynamic&lt;/td&gt;
					&lt;td&gt;INT8(W), FP32(A)&lt;/td&gt;
					&lt;td&gt;⭐&lt;/td&gt;
					&lt;td&gt;🔸중간&lt;/td&gt;
					&lt;td&gt;❌&lt;/td&gt;
					&lt;td&gt;NLP, RNN&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;PTQ-Static&lt;/td&gt;
					&lt;td&gt;INT8(W+A)&lt;/td&gt;
					&lt;td&gt;⭐⭐&lt;/td&gt;
					&lt;td&gt;🔸&lt;/td&gt;
					&lt;td&gt;❌&lt;/td&gt;
					&lt;td&gt;CNN&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;QAT&lt;/td&gt;
					&lt;td&gt;INT8(W+A)&lt;/td&gt;
					&lt;td&gt;⭐⭐&lt;/td&gt;
					&lt;td&gt;🔹낮음&lt;/td&gt;
					&lt;td&gt;✅&lt;/td&gt;
					&lt;td&gt;실사용 모델&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;FP16/BF16&lt;/td&gt;
					&lt;td&gt;FP16&lt;/td&gt;
					&lt;td&gt;⭐&lt;/td&gt;
					&lt;td&gt;없음~적음&lt;/td&gt;
					&lt;td&gt;❌&lt;/td&gt;
					&lt;td&gt;GPU/TPU&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;Integer-only&lt;/td&gt;
					&lt;td&gt;INT8&lt;/td&gt;
					&lt;td&gt;⭐⭐⭐&lt;/td&gt;
					&lt;td&gt;🔸크다&lt;/td&gt;
					&lt;td&gt;❌&lt;/td&gt;
					&lt;td&gt;모바일/IoT&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;</description></item><item><title/><link>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/1.ptq/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/1.ptq/</guid><description>&lt;h1 id="1-post-training-quantization-ptq"&gt;1. Post-Training Quantization (PTQ)&lt;/h1&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;특징&lt;/th&gt;
					&lt;th&gt;설명&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;적용 시점&lt;/td&gt;
					&lt;td&gt;학습 이후&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;대상&lt;/td&gt;
					&lt;td&gt;weight만 또는 weight + activation&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;정밀도&lt;/td&gt;
					&lt;td&gt;FP32 → INT8 or FP16&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;장점&lt;/td&gt;
					&lt;td&gt;간단, 빠름, 학습 필요 없음&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;단점&lt;/td&gt;
					&lt;td&gt;정확도 손실 가능성&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;하위 유형:&lt;/p&gt;
&lt;p&gt;&lt;code&gt;Dynamic Quantization&lt;/code&gt;&lt;/p&gt;
&lt;p&gt;weight만 INT8로 변환하고, activation은 FP32로 유지&lt;/p&gt;
&lt;p&gt;(runtime에 quantization) 주로 RNN, Transformer 계열에서 많이 사용&lt;/p&gt;
&lt;p&gt;&lt;code&gt;Static Quantization&lt;/code&gt;&lt;/p&gt;
&lt;p&gt;weight + activation 모두 양자화&lt;/p&gt;
&lt;p&gt;calibration data로 범위(min/max) 측정 필요&lt;/p&gt;
&lt;p&gt;&lt;code&gt;Weight-only Quantization&lt;/code&gt;&lt;/p&gt;
&lt;p&gt;weight만 quantize (activation은 그대로)&lt;/p&gt;
&lt;h3 id="sample"&gt;sample&lt;/h3&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-python" data-lang="python"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#75715e"&gt;# Post Training Static Quantization (PyTorch)&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#f92672"&gt;import&lt;/span&gt; torch.quantization
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;model_fp32 &lt;span style="color:#f92672"&gt;=&lt;/span&gt; YourModel()
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;model_fp32&lt;span style="color:#f92672"&gt;.&lt;/span&gt;eval()
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;model_fp32&lt;span style="color:#f92672"&gt;.&lt;/span&gt;qconfig &lt;span style="color:#f92672"&gt;=&lt;/span&gt; torch&lt;span style="color:#f92672"&gt;.&lt;/span&gt;quantization&lt;span style="color:#f92672"&gt;.&lt;/span&gt;get_default_qconfig(&lt;span style="color:#e6db74"&gt;&amp;#39;fbgemm&amp;#39;&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;torch&lt;span style="color:#f92672"&gt;.&lt;/span&gt;quantization&lt;span style="color:#f92672"&gt;.&lt;/span&gt;prepare(model_fp32, inplace&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#66d9ef"&gt;True&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;torch&lt;span style="color:#f92672"&gt;.&lt;/span&gt;quantization&lt;span style="color:#f92672"&gt;.&lt;/span&gt;convert(model_fp32, inplace&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#66d9ef"&gt;True&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description></item><item><title/><link>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/2.qat/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/2.qat/</guid><description>&lt;h1 id="2-quantization-aware-training-qat"&gt;2. Quantization Aware Training (QAT)&lt;/h1&gt;
&lt;p&gt;학습 중에 양자화 효과를 반영하여 성능 손실을 최소화하는 방식&lt;/p&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;특징&lt;/th&gt;
					&lt;th&gt;설명&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;적용 시점&lt;/td&gt;
					&lt;td&gt;학습 중&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;정밀도&lt;/td&gt;
					&lt;td&gt;FP32 → INT8&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;장점&lt;/td&gt;
					&lt;td&gt;정확도 손실 최소화&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;단점&lt;/td&gt;
					&lt;td&gt;추가 학습 필요 (시간 소비), 구현 복잡도 ↑&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;
&lt;h3 id="원리"&gt;원리&lt;/h3&gt;
&lt;p&gt;학습 중 양자화 시뮬레이션을 수행하여, 양자화 노이즈를 반영함&lt;/p&gt;
&lt;p&gt;파라미터 업데이트는 FP32지만, forward-pass는 양자화된 값 사용&lt;/p&gt;
&lt;h3 id="sample"&gt;Sample&lt;/h3&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-python" data-lang="python"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#75715e"&gt;# Quantization Aware Training&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;model&lt;span style="color:#f92672"&gt;.&lt;/span&gt;train()
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;model&lt;span style="color:#f92672"&gt;.&lt;/span&gt;qconfig &lt;span style="color:#f92672"&gt;=&lt;/span&gt; torch&lt;span style="color:#f92672"&gt;.&lt;/span&gt;quantization&lt;span style="color:#f92672"&gt;.&lt;/span&gt;get_default_qat_qconfig(&lt;span style="color:#e6db74"&gt;&amp;#39;fbgemm&amp;#39;&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;torch&lt;span style="color:#f92672"&gt;.&lt;/span&gt;quantization&lt;span style="color:#f92672"&gt;.&lt;/span&gt;prepare_qat(model, inplace&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#66d9ef"&gt;True&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#75715e"&gt;# Fine-tune...&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;torch&lt;span style="color:#f92672"&gt;.&lt;/span&gt;quantization&lt;span style="color:#f92672"&gt;.&lt;/span&gt;convert(model&lt;span style="color:#f92672"&gt;.&lt;/span&gt;eval(), inplace&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#66d9ef"&gt;True&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description></item><item><title/><link>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/3.integer-only_quantization/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/3.integer-only_quantization/</guid><description>&lt;h1 id="3-integer-only-quantization"&gt;3. Integer-only Quantization&lt;/h1&gt;
&lt;p&gt;모든 연산을 정수(INT8)로 수행 (weight, activation, 연산 결과까지)&lt;/p&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;특징&lt;/th&gt;
					&lt;th&gt;설명&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;대상&lt;/td&gt;
					&lt;td&gt;Embedded, Mobile, IoT&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;장점&lt;/td&gt;
					&lt;td&gt;속도 최강, GPU/TPU 비의존&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;단점&lt;/td&gt;
					&lt;td&gt;정확도 손실 가능성 ↑&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;
&lt;h3 id="사용처"&gt;사용처&lt;/h3&gt;
&lt;p&gt;TensorFlow Lite INT8&lt;/p&gt;
&lt;p&gt;Edge-TPU용 모델&lt;/p&gt;</description></item><item><title/><link>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/4.fp16_bf16_quantization/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://kimchioverfit.github.io/Study/mldnn/basics/60_model_optimization/quantization/4.fp16_bf16_quantization/</guid><description>&lt;h1 id="4-fp16--bf16-quantization"&gt;4. FP16 / BF16 Quantization&lt;/h1&gt;
&lt;p&gt;32비트 부동소수점(FP32)을 16비트 부동소수점으로 줄이는 방법&lt;/p&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;비교 항목&lt;/th&gt;
					&lt;th&gt;FP16&lt;/th&gt;
					&lt;th&gt;BF16&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;정확도&lt;/td&gt;
					&lt;td&gt;FP32에 가깝다&lt;/td&gt;
					&lt;td&gt;더 큼&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;성능&lt;/td&gt;
					&lt;td&gt;빠름 (GPU 최적화)&lt;/td&gt;
					&lt;td&gt;TPU, CPU 특화&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;호환성&lt;/td&gt;
					&lt;td&gt;NVIDIA GPU&lt;/td&gt;
					&lt;td&gt;Intel, TPU&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;</description></item></channel></rss>